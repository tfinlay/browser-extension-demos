{
    "manifest_version": 3,
    "name": "Native messaging example - password manager",
    "version": "0.0",
    "browser_specific_settings": {
        "gecko": {
            "id": "native_messaging_example@tfinlay.io",
            "strict_min_version": "50.0"
        }
    },
    "action": {
        "default_title": "Auto-fill login"
    },
    "background": {
        "service_worker": "background.js",
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content_script.js"
            ]
        }
    ],
    "permissions": [
        "nativeMessaging",
        "activeTab"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}